# LLM access — security-baseline: never hardcode keys; load from env only.
# The product auto-selects a provider (see src/shared/llm.ts):

# Provider A — Amazon Bedrock (bearer token). Used for the hackathon demo.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=ap-northeast-2
LLM_MODEL=global.anthropic.claude-opus-4-8
# Note: the [1m] 1M-context profile requires separate Bedrock entitlement; the standard
# profile above (200K context) is sufficient and is the verified default.

# Provider B — Anthropic Messages API (alt). Set this instead of the Bedrock vars above.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# LLM_MODEL=claude-opus-4-8

PORT=3000

# STT 얇은 어댑터(선택, §4). 미설정 시 음성입력만 비활성.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# STT_MODEL=whisper-1
